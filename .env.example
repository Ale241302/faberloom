# ── FaberLoom · MCP HTTP ──────────────────────────────────────────────
# Copia a .env. NO subir .env al repositorio.

# Secreto compartido con el gateway del harness (cabecera X-Faberloom-Gateway-Key).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FABERLOOM_GATEWAY_KEY=

# Usuario por defecto si no llega cabecera de identidad.
FABERLOOM_USER_ID=anon

# Puerto HTTP (el compose ya fija 8090).
FABERLOOM_PORT=8090

# ── Almacén de contenido de los vínculos ──────────────────────────────
# memory (por defecto) | fs | s3
# fs  → FABERLOOM_BLOB_DIR=/data/blobs
# s3  → MinIO/S3 (variables siguientes)
FABERLOOM_BLOB_STORE=s3
FABERLOOM_S3_ENDPOINT=http://mwt-minio:9000
FABERLOOM_S3_BUCKET=faberloom
FABERLOOM_S3_ACCESS_KEY=
FABERLOOM_S3_SECRET_KEY=
FABERLOOM_S3_REGION=us-east-1
